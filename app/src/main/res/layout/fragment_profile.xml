<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="?attr/colorPrimary">

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/circle_background"
            android:src="@android:drawable/ic_menu_camera"
            android:padding="16dp"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/ivProfile"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="johndoe@email.com"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@android:color/white" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/menuOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pesanan Saya"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_agenda"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/menuAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alamat Pengiriman"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/menuPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Metode Pembayaran"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_compass"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/menuVoucher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voucher Saya"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_gallery"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/menuFavorite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Favorit"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_camera"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginVertical="8dp" />

            <TextView
                android:id="@+id/menuAccountSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengaturan Akun"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_preferences"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/menuLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keluar"
                android:textColor="#E53935"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_close_clear_cancel"
                android:drawablePadding="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>